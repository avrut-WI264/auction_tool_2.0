SPRING_PROFILES_ACTIVE=prod
APP_DATABASE_SCHEMA=auction_app
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_DB_HOST:5432/YOUR_DB_NAME?currentSchema=auction_app&sslmode=verify-full
SPRING_DATASOURCE_USERNAME=auction_runtime
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_A_SECRET
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
METRICS_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
FRONTEND_URL=https://YOUR_AUCTION_DOMAIN
COOKIE_SECURE=true
GEMINI_API_KEY=
# Only trust the IP ranges of your actual reverse proxies.
TRUSTED_PROXY_PATTERN=127\.0\.0\.1|::1
